PORT=3000
HOST=0.0.0.0
BCRYPT_SALT_ROUNDS=10
CORS_ORIGINS=*

# Option A (recommended for cloud providers): one connection string
DATABASE_URL=

# Option B (manual host/user/password values)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=group_project

# Enable if your cloud provider requires TLS/SSL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Optional tuning
DB_CONNECTION_LIMIT=10

# Optional: used by scripts/create_app_user.js
# Use APP_DB_HOST=% only if you intentionally allow DB login from remote hosts.
APP_DB_USER=app_user
APP_DB_PASSWORD=
APP_DB_HOST=localhost
